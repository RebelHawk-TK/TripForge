rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // PDF exports: only the owning user can read/write
    match /users/{uid}/exports/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Private travel-doc vault: no client access at all. Files are written by
    // admin tooling and served only through the serveVaultDoc function, which
    // uses the Admin SDK and bypasses these rules.
    match /vault/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
